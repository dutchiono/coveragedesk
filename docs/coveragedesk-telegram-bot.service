[Unit]
Description=CoverageDesk Telegram Assistant & Moderator Bot
After=network.target coveragedesk-api.service

[Service]
User=drink
WorkingDirectory=/srv/drink/apps/coveragedesk/backend
EnvironmentFile=/srv/drink/apps/coveragedesk/backend/.telegram-bot.env
ExecStart=/srv/drink/apps/coveragedesk/backend/.venv/bin/python telegram_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
